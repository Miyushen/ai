OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_USE_RESPONSES_API=true
# Optional for reasoning models; leave disabled for models that do not support these fields.
OPENAI_REASONING_EFFORT=
OPENAI_VERBOSITY=
OPENAI_MAX_COMPLETION_TOKENS=0
DATABASE_URL=postgresql+psycopg://insight:insight@db:5432/insight
API_BASE_URL=http://api:8000
MAX_SQL_ROWS=200
SQL_TIMEOUT_MS=10000
MAX_AGENT_RETRIES=2
MODEL_NODE_MAX_ATTEMPTS=3
# Optional provider pricing for estimated cost display. Keep 0 when unknown.
MODEL_INPUT_COST_PER_1M=0
MODEL_OUTPUT_COST_PER_1M=0

